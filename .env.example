# ===================================================
# TeamSync – Event-Based Team Formation and Matching System
# Environment Variables
# ===================================================

# JWT Authentication
JWT_SECRET="your_secure_jwt_secret_key_change_in_production"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===================================================
# Firebase Client SDK (public — safe to expose in browser)
# ===================================================
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_firebase_app_id"

# ===================================================
# Firebase Admin SDK (server-side only — keep secret!)
# Option A: Base64-encoded service account JSON (recommended for Vercel)
# Generate: base64 -w 0 serviceAccountKey.json
# ===================================================
# FIREBASE_SERVICE_ACCOUNT_JSON="<base64_encoded_service_account_json>"

# Option B: Individual credentials (local dev only)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
